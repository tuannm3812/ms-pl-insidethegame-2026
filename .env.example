# Copy to .env (never committed) and fill in ONE of the options below.

# Option A: key from your Foundry model deployment
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=<deployment name, e.g. gpt-4.1-mini>

# Option B: keyless, signs in with `az login` or a managed identity
# FOUNDRY_PROJECT_ENDPOINT=https://<name>.services.ai.azure.com/api/projects/<project>
# FOUNDRY_MODEL=<deployment name>
